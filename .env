# 项目名称
PROJECT_NAME=tc-http-server

# 后端服务配置
BACKEND_PORT=8081
BACKEND_THREADS=4

# MySQL 配置
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=cloud_disk_db
MYSQL_USER=Boyu
MYSQL_PASSWORD=123456
MYSQL_PORT=3306

# Redis 配置
REDIS_PORT=6379

# Nginx 配置
NGINX_PORT=80

# FastDFS 配置
FASTDFS_TRACKER_PORT=22122
FASTDFS_STORAGE_PORT=23000

# 存储路径
DATA_DIR=./data

# AI 功能配置（可选）
ENABLE_AI=true
DASHSCOPE_API_KEY=${DASHSCOPE_API_KEY:-}

# 前端配置
FRONTEND_PORT=3000

# 启动选项（开发环境设为 false 可加快启动）
WAIT_DEPENDENCIES=true