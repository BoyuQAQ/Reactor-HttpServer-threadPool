# React 前端 Dockerfile
FROM node:18-alpine AS builder

# 设置工作目录
WORKDIR /app

# 复制 package 文件（context 为 ./AI_YunCunChu-main/picture_bed）
COPY package*.json ./

# 安装依赖
RUN npm ci --legacy-peer-deps

# 复制源代码（context 为 ./AI_YunCunChu-main/picture_bed）
COPY . ./

# 构建应用
RUN npm run build

# 运行镜像 - 使用 nginx 提供静态文件
FROM nginx:1.25-alpine

# 复制构建产物
COPY --from=builder /app/build /usr/share/nginx/html

# 复制 nginx 配置
COPY --from=0 nginx.conf /etc/nginx/conf.d/default.conf

# 暴露端口
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]